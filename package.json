{
  "name": "multivendor-ecommerce-platform",
  "version": "1.0.0",
  "description": "Production-grade Full-Stack Multi-Vendor E-Commerce Platform",
  "private": true,
  "scripts": {
    "install:all": "npm.cmd install && cd server && npm.cmd install && cd ../client && npm.cmd install",
    "dev:server": "cd server && npm.cmd run dev",
    "dev:client": "cd client && npm.cmd run dev",
    "dev": "concurrently \"npm.cmd run dev:server\" \"npm.cmd run dev:client\"",
    "build:server": "cd server && npm.cmd run build",
    "build:client": "cd client && npm.cmd run build",
    "build": "npm.cmd run build:server && npm.cmd run build:client",
    "seed": "cd server && npm.cmd run seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
